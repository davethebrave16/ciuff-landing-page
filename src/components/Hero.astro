---
const DROP_PATH = 'M50,18 C64,36 76,52 76,66 A26,26 0 1,1 24,66 C24,52 36,36 50,18 Z'

const ripples = [
	{ r: 50, opacity: 0.5 },
	{ r: 90, opacity: 0.4 },
	{ r: 130, opacity: 0.3 },
	{ r: 170, opacity: 0.2 },
]

const drops = [
	{ cx: 300, cy: 90, s: 34, color: '#C4E538' },
	{ cx: 90, cy: 260, s: 46, color: '#FF6B4A' },
	{ cx: 150, cy: 90, s: 20, color: 'rgba(234,242,239,0.5)' },
]
---

<section style="background:#0E3B43; position:relative; overflow:hidden;">
	<div
		style="max-width:1200px; margin:0 auto; padding:72px 56px 96px; display:grid; grid-template-columns:1.1fr 0.9fr; gap:48px; align-items:center;"
	>
		<div style="position:relative; z-index:1;">
			<div
				style="display:inline-block; font-size:13px; font-weight:600; letter-spacing:0.1em; color:#C4E538; background:rgba(196,229,56,0.12); border-radius:2px; padding:6px 14px; margin-bottom:28px;"
			>
				CONCEPT IN VALIDAZIONE — NON ANCORA IN VENDITA
			</div>
			<h1 class="disp" style="font-size:76px; line-height:1.02; color:#EAF2EF; margin:0 0 28px;">
				LA BIRRA RESTA BIRRA.<br /><span style="color:#C4E538;">L'ACQUA RESTA ACQUA.</span>
			</h1>
			<p style="font-size:19px; line-height:1.6; color:#EAF2EF; opacity:0.85; max-width:460px; margin:0 0 36px;">
				L'accessorio anti-spruzzo per la piscina, in fase di validazione. Niente tappi da aprire
				o chiudere: pensato per restare sempre pronto e tenere fuori gli spruzzi mentre bevi
				quando vuoi.
			</p>
			<a
				href="#iscriviti"
				style="display:inline-block; text-decoration:none; background:#C4E538; color:#0E3B43; font-weight:700; font-size:16px; border-radius:2px; padding:16px 32px;"
			>
				Voglio saperne di più
			</a>
		</div>
		<div style="position:relative; height:360px;">
			<svg width="100%" height="100%" viewBox="0 0 400 360" style="position:absolute; inset:0;">
				{
					ripples.map((ring) => (
						<circle
							cx="300"
							cy="90"
							r={ring.r}
							fill="none"
							stroke="#145C63"
							stroke-width="2"
							opacity={ring.opacity}
						/>
					))
				}
				{
					drops.map((drop) => {
						const scale = drop.s / 100
						const x = drop.cx - 50 * scale
						const y = drop.cy - 50 * scale
						return (
							<g transform={`translate(${x} ${y}) scale(${scale})`}>
								<path d={DROP_PATH} fill={drop.color} />
							</g>
						)
					})
				}
			</svg>
		</div>
	</div>
</section>
