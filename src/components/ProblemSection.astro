---
const DROP_PATH = 'M50,18 C64,36 76,52 76,66 A26,26 0 1,1 24,66 C24,52 36,36 50,18 Z'
const dropScale = 90 / 100
const dropX = 200 - 50 * dropScale
const dropY = 130 - 50 * dropScale
---

<section style="max-width:1200px; margin:0 auto; padding:clamp(56px,10vw,96px) clamp(20px,6vw,56px);">
	<div class="problem-grid" style="display:grid; gap:56px; align-items:center;">
		<div>
			<svg width="100%" height="320" viewBox="0 0 400 320">
				<circle cx="200" cy="160" r="150" fill="#145C63" opacity="0.08" />
				<g transform={`translate(${dropX} ${dropY}) scale(${dropScale})`}>
					<path d={DROP_PATH} fill="#0E3B43" />
				</g>
				<circle cx="300" cy="90" r="12" fill="#FF6B4A" />
				<circle cx="90" cy="200" r="8" fill="#C4E538" />
				<circle cx="320" cy="220" r="6" fill="#145C63" />
			</svg>
		</div>
		<div>
			<div style="font-size:13px; font-weight:600; letter-spacing:0.1em; color:#FF6B4A; margin-bottom:16px;">
				IL PROBLEMA
			</div>
			<h2 class="disp" style="font-size:clamp(1.75rem,5vw,2.75rem); line-height:1.08; margin:0 0 20px; color:#0E3B43;">
				OGNI TUFFO È UNA ROULETTE PER LA TUA BIRRA
			</h2>
			<p style="font-size:17px; line-height:1.7; color:#0E3B43; opacity:0.85; max-width:440px; margin:0;">
				Basta un salto in piscina vicino, un tuffo di un amico, un colpo di vento sull'acqua — e
				la bottiglia lasciata sul bordo si ritrova mezza acqua e mezza schiuma. Ogni volta la
				stessa storia.
			</p>
		</div>
	</div>
</section>

<style>
	.problem-grid {
		grid-template-columns: 1fr 1fr;
	}

	@media (max-width: 760px) {
		.problem-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
