---
const disclaimer =
	"CIUFF è un concept in fase di validazione. Iscrivendoti riceverai solo aggiornamenti sul progetto, nessun obbligo d'acquisto."
---

<section id="iscriviti" style="background:#0E3B43; padding:96px 56px;">
	<div style="max-width:560px; margin:0 auto; text-align:center;">
		<h2 class="disp" style="font-size:40px; color:#EAF2EF; margin:0 0 16px;">
			SII TRA I PRIMI A PROVARLO
		</h2>
		<p style="font-size:16px; color:#EAF2EF; opacity:0.8; margin:0 0 36px;">
			Lasciaci la tua email: ti avviseremo appena pronto e ti terremo aggiornato sul set che
			preferisci.
		</p>

		<form id="signup-form" class="signup-form">
			<input
				type="email"
				id="signup-email"
				required
				placeholder="la-tua-email@esempio.it"
				style="width:100%; box-sizing:border-box; font-family:'Space Grotesk',sans-serif; font-size:16px; padding:16px 18px; border-radius:2px; border:none; background:#EAF2EF; color:#0E3B43;"
			/>
			<div style="font-size:13px; color:#EAF2EF; opacity:0.6;">
				Set selezionato: <span id="selected-tier-label" style="color:#C4E538; font-weight:600;">Gruppo — 6 pz, 9,99 €</span>
			</div>
			<button
				type="submit"
				style="width:100%; font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:16px; background:#C4E538; color:#0E3B43; border:none; border-radius:2px; padding:16px;"
			>
				Avvisami al lancio
			</button>
			<p style="font-size:12px; color:#EAF2EF; opacity:0.55; margin:4px 0 0; line-height:1.5;">
				{disclaimer}
			</p>
		</form>

		<div id="signup-confirmation" class="signup-confirmation" hidden style="background:rgba(196,229,56,0.12); border-radius:4px; padding:32px;">
			<div class="disp" style="font-size:26px; color:#C4E538; margin-bottom:8px;">CI SIAMO.</div>
			<p style="font-size:15px; color:#EAF2EF; opacity:0.85; margin:0;">
				Ti scriveremo appena CIUFF è pronto. Set preferito: <strong id="confirmation-tier-label">Gruppo — 6 pz, 9,99 €</strong>.
			</p>
			<p style="font-size:12px; color:#EAF2EF; opacity:0.55; margin:16px 0 0; line-height:1.5;">
				{disclaimer}
			</p>
		</div>
	</div>
</section>
